{
  "name": "travelguide-frontend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@4.2.2",
  "engines": {
    "node": "20.x"
  },
  "resolutions": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\"",
    "lint": "eslint . --max-warnings=0",
    "start": "next start",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "yarn lint && yarn format:check && yarn typecheck && yarn test:coverage && yarn build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.51.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.11",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "8.5.25",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.1",
    "typescript": "5.8.3"
  }
}
