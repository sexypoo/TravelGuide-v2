NODE_ENV=development
DATABASE_URL=postgresql://travelguide:travelguide@localhost:5432/travelguide
TEST_DATABASE_URL=postgresql://travelguide:travelguide@localhost:5432/travelguide_test
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Used from T01 onward. Never commit real secrets.
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Used from the verification/storage task onward.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/private-uploads
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_URL_STYLE=virtual
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Docker Compose development database settings.
POSTGRES_USER=travelguide
POSTGRES_PASSWORD=travelguide
POSTGRES_DB=travelguide
POSTGRES_PORT=5432

# Optional local/demo seed. Keep real values in an ignored local env file.
DEMO_SEED_ENABLED=false
DEMO_SEED_CONFIRM_PRODUCTION=
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
GOOGLE_PLACES_API_KEY=

# T36 password recovery. Verify travelguide.kr in Resend before production.
RESEND_API_KEY=
EMAIL_FROM=

# T36 social login. Each provider group is optional, but a configured group
# must contain every value. Register callback URLs as:
# https://www.travelguide.kr/api/v1/auth/oauth/{provider}/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
