NODE_ENV=development
DATABASE_URL=postgresql://travelguide:travelguide@localhost:5432/travelguide
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Used from T01 onward. Never commit real secrets.
JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Used from the verification/storage task onward.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/private-uploads
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Docker Compose development database settings.
POSTGRES_USER=travelguide
POSTGRES_PASSWORD=travelguide
POSTGRES_DB=travelguide
POSTGRES_PORT=5432
