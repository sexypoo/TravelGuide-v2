generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(320)
  passwordHash String
  nickname     String   @unique @db.VarChar(20)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Infrastructure-only record used to prove the initial Prisma migration and
// connection without introducing any product-domain model in T00.
model SystemMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
