generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationType {
  TRAVELER
  LOCAL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum LocalProofType {
  RESIDENCE
  WORK
  STUDY
  OTHER
}

enum QuestionCategory {
  WEATHER
  TRANSPORT
  FOOD
  PLACE
  SAFETY
  OTHER
}

enum QuestionUrgency {
  NORMAL
  URGENT
}

enum QuestionStatus {
  OPEN
  RESOLVED
  REMOVED
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique @db.VarChar(320)
  passwordHash          String
  nickname              String         @unique @db.VarChar(20)
  bio                   String?        @db.VarChar(300)
  role                  UserRole       @default(USER)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  verifications         Verification[] @relation("VerificationApplicant")
  reviewedVerifications Verification[] @relation("VerificationReviewer")
  questions             Question[]     @relation("QuestionAuthor")
  removedQuestions      Question[]     @relation("QuestionRemover")
}

model Destination {
  id              String           @id @default(cuid())
  slug            String           @unique @db.VarChar(64)
  nameKo          String           @db.VarChar(100)
  countryCode     String           @db.Char(2)
  timezone        String           @db.VarChar(64)
  centerLatitude  Decimal          @db.Decimal(9, 6)
  centerLongitude Decimal          @db.Decimal(9, 6)
  radiusKm        Decimal          @db.Decimal(6, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  room            DestinationRoom?
  verifications   Verification[]
}

model DestinationRoom {
  id            String      @id @default(cuid())
  slug          String      @unique @db.VarChar(64)
  destinationId String      @unique
  title         String      @db.VarChar(120)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  questions     Question[]
}

model Question {
  id               String           @id @default(cuid())
  roomId           String
  authorId         String
  category         QuestionCategory
  urgency          QuestionUrgency
  content          String           @db.VarChar(1000)
  areaText         String?          @db.VarChar(60)
  status           QuestionStatus   @default(OPEN)
  acceptedAnswerId String?          @unique
  expiresAt        DateTime
  resolvedAt       DateTime?
  removedAt        DateTime?
  removedById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  room             DestinationRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author           User             @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy        User?            @relation("QuestionRemover", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([roomId, status, createdAt, id])
  @@index([authorId, status])
  @@index([expiresAt])
}

model Verification {
  id                String             @id @default(cuid())
  userId            String
  destinationId     String
  type              VerificationType
  status            VerificationStatus @default(PENDING)
  startsAt          DateTime?
  endsAt            DateTime?
  localProofType    LocalProofType?
  proofObjectKey    String             @db.VarChar(255)
  proofOriginalName String             @db.VarChar(255)
  proofMimeType     String             @db.VarChar(64)
  proofSizeBytes    Int
  gpsLat            Decimal?           @db.Decimal(9, 6)
  gpsLng            Decimal?           @db.Decimal(9, 6)
  gpsAccuracyMeters Int?
  gpsCapturedAt     DateTime?
  submittedNote     String?            @db.VarChar(300)
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?            @db.VarChar(300)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  destination       Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  reviewedBy        User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, destinationId, type, status])
  @@index([status, createdAt])
  @@index([destinationId, type, status])
}

// Infrastructure-only record used to prove the initial Prisma migration and
// connection without introducing any product-domain model in T00.
model SystemMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
