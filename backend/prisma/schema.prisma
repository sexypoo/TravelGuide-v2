generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationType {
  TRAVELER
  LOCAL
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  EXPIRED
}

enum LocalProofType {
  RESIDENCE
  WORK
  STUDY
  OTHER
}

enum QuestionCategory {
  WEATHER
  TRANSPORT
  FOOD
  PLACE
  WAITING
  CROWD
  OPEN_HOURS
  EVENT
  SAFETY
  OTHER
}

enum ChatMessageType {
  TEXT
  IMAGE
  PLACE
  TOPIC_SHARE
}

enum CrowdLevel {
  QUIET
  MODERATE
  BUSY
  VERY_BUSY
}

enum EntryStatus {
  OPEN
  LIMITED
  PAUSED
  CLOSED
  UNKNOWN
}

enum QuestionUrgency {
  NORMAL
  URGENT
}

enum QuestionStatus {
  OPEN
  RESOLVED
  REMOVED
}

enum AnswerSourceType {
  ON_SITE_NOW
  RECENT_EXPERIENCE
  OFFICIAL_SOURCE
  PERSONAL_OPINION
}

enum RoomParticipantKind {
  TRAVELER
  LOCAL
  BOTH
}

enum ReportTargetType {
  MESSAGE
  QUESTION
  ANSWER
  COMMUNITY_POST
  COMMUNITY_COMMENT
  USER
}

enum CommunityPostCategory {
  TRAVEL_TIP
  TRANSPORT
  FOOD
  PLACE
  QUESTION
  OTHER
}

enum ReportReason {
  SPAM
  ABUSE
  FALSE_INFORMATION
  ADVERTISEMENT
  PRIVACY
  SAFETY
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model User {
  id                       String             @id @default(cuid())
  email                    String             @unique @db.VarChar(320)
  passwordHash             String
  nickname                 String             @unique @db.VarChar(20)
  bio                      String?            @db.VarChar(300)
  role                     UserRole           @default(USER)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  verifications            Verification[]     @relation("VerificationApplicant")
  reviewedVerifications    Verification[]     @relation("VerificationReviewer")
  questions                Question[]         @relation("QuestionAuthor")
  removedQuestions         Question[]         @relation("QuestionRemover")
  answers                  Answer[]           @relation("AnswerAuthor")
  removedAnswers           Answer[]           @relation("AnswerRemover")
  chatMessages             ChatMessage[]
  removedChatMessages      ChatMessage[]      @relation("ChatMessageRemover")
  reports                  Report[]           @relation("ReportReporter")
  reviewedReports          Report[]           @relation("ReportReviewer")
  communityPosts           CommunityPost[]    @relation("CommunityPostAuthor")
  communityComments        CommunityComment[] @relation("CommunityCommentAuthor")
  removedCommunityPosts    CommunityPost[]    @relation("CommunityPostRemover")
  removedCommunityComments CommunityComment[] @relation("CommunityCommentRemover")
}

model Destination {
  id              String           @id @default(cuid())
  slug            String           @unique @db.VarChar(64)
  nameKo          String           @db.VarChar(100)
  countryCode     String           @db.Char(2)
  timezone        String           @db.VarChar(64)
  centerLatitude  Decimal          @db.Decimal(9, 6)
  centerLongitude Decimal          @db.Decimal(9, 6)
  radiusKm        Decimal          @db.Decimal(6, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  room            DestinationRoom?
  verifications   Verification[]
}

model DestinationRoom {
  id            String        @id @default(cuid())
  slug          String        @unique @db.VarChar(64)
  destinationId String        @unique
  title         String        @db.VarChar(120)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  destination   Destination   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  questions     Question[]
  messages      ChatMessage[]
}

model Question {
  id                String              @id @default(cuid())
  roomId            String
  authorId          String
  authorKind        RoomParticipantKind @default(TRAVELER)
  sourceMessageId   String?             @unique
  category          QuestionCategory
  urgency           QuestionUrgency
  content           String              @db.VarChar(1000)
  areaText          String?             @db.VarChar(60)
  imageObjectKey    String?             @db.VarChar(255)
  imageOriginalName String?             @db.VarChar(255)
  imageMimeType     String?             @db.VarChar(64)
  imageSizeBytes    Int?
  status            QuestionStatus      @default(OPEN)
  acceptedAnswerId  String?             @unique
  expiresAt         DateTime
  resolvedAt        DateTime?
  removedAt         DateTime?
  removedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  room              DestinationRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author            User                @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy         User?               @relation("QuestionRemover", fields: [removedById], references: [id], onDelete: SetNull)
  answers           Answer[]            @relation("QuestionAnswers")
  acceptedAnswer    Answer?             @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  sourceMessage     ChatMessage?        @relation("SourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  sharedMessages    ChatMessage[]       @relation("SharedQuestion")

  @@index([roomId, status, createdAt, id])
  @@index([authorId, status])
  @@index([expiresAt])
}

model ChatMessage {
  id                String              @id @default(cuid())
  roomId            String
  authorId          String
  authorKind        RoomParticipantKind
  type              ChatMessageType     @default(TEXT)
  content           String              @db.VarChar(500)
  imageObjectKey    String?             @db.VarChar(255)
  imageOriginalName String?             @db.VarChar(255)
  imageMimeType     String?             @db.VarChar(64)
  imageSizeBytes    Int?
  placeName         String?             @db.VarChar(100)
  placeAddress      String?             @db.VarChar(200)
  placeLatitude     Decimal?            @db.Decimal(9, 6)
  placeLongitude    Decimal?            @db.Decimal(9, 6)
  sharedQuestionId  String?
  removedAt         DateTime?
  removedById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  room              DestinationRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author            User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  removedBy         User?               @relation("ChatMessageRemover", fields: [removedById], references: [id], onDelete: SetNull)
  topic             Question?           @relation("SourceMessage")
  sharedQuestion    Question?           @relation("SharedQuestion", fields: [sharedQuestionId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt, id])
  @@index([authorId, createdAt])
  @@index([sharedQuestionId])
}

model Answer {
  id                  String              @id @default(cuid())
  questionId          String
  authorId            String
  authorKind          RoomParticipantKind @default(LOCAL)
  content             String              @db.VarChar(1000)
  sourceType          AnswerSourceType
  sourceUrl           String?             @db.VarChar(2048)
  waitMinutes         Int?
  crowdLevel          CrowdLevel?
  entryStatus         EntryStatus?
  observedAt          DateTime?
  imageObjectKey      String?             @db.VarChar(255)
  imageOriginalName   String?             @db.VarChar(255)
  imageMimeType       String?             @db.VarChar(64)
  imageSizeBytes      Int?
  removedAt           DateTime?
  removedById         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  question            Question            @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  author              User                @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy           User?               @relation("AnswerRemover", fields: [removedById], references: [id], onDelete: SetNull)
  acceptedForQuestion Question?           @relation("AcceptedAnswer")

  @@index([questionId, createdAt, id])
  @@index([authorId, createdAt])
}

model Verification {
  id                String             @id @default(cuid())
  userId            String
  destinationId     String
  type              VerificationType
  status            VerificationStatus @default(PENDING)
  startsAt          DateTime?
  endsAt            DateTime?
  localProofType    LocalProofType?
  proofObjectKey    String             @db.VarChar(255)
  proofOriginalName String             @db.VarChar(255)
  proofMimeType     String             @db.VarChar(64)
  proofSizeBytes    Int
  gpsLat            Decimal?           @db.Decimal(9, 6)
  gpsLng            Decimal?           @db.Decimal(9, 6)
  gpsAccuracyMeters Int?
  gpsCapturedAt     DateTime?
  submittedNote     String?            @db.VarChar(300)
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?            @db.VarChar(300)
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  destination       Destination        @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  reviewedBy        User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, destinationId, type, status])
  @@index([status, createdAt])
  @@index([destinationId, type, status])
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  detail         String?          @db.VarChar(300)
  status         ReportStatus     @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  resolutionNote String?          @db.VarChar(300)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reporter       User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy     User?            @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, status, createdAt])
  @@index([targetId])
}

model CommunityPost {
  id          String                @id @default(cuid())
  authorId    String
  category    CommunityPostCategory
  areaText    String?               @db.VarChar(60)
  title       String                @db.VarChar(100)
  content     String                @db.VarChar(2000)
  removedAt   DateTime?
  removedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  author      User                  @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy   User?                 @relation("CommunityPostRemover", fields: [removedById], references: [id], onDelete: SetNull)
  comments    CommunityComment[]

  @@index([category, createdAt, id])
  @@index([createdAt, id])
  @@index([authorId, createdAt])
}

model CommunityComment {
  id          String        @id @default(cuid())
  postId      String
  authorId    String
  content     String        @db.VarChar(500)
  removedAt   DateTime?
  removedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author      User          @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy   User?         @relation("CommunityCommentRemover", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([postId, createdAt, id])
  @@index([authorId, createdAt])
}

// Infrastructure-only record used to prove the initial Prisma migration and
// connection without introducing any product-domain model in T00.
model SystemMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
