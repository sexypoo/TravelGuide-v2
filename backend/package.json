{
  "name": "travelguide-backend",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "yarn@4.2.2",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "nest build",
    "db:deploy": "prisma migrate deploy",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:up": "docker compose up -d --wait",
    "db:validate": "prisma validate",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "lint": "eslint src test prisma --max-warnings=0",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:integration": "jest --config test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn test:integration && yarn db:validate && yarn build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "5.22.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.11",
    "@types/supertest": "6.0.3",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "prisma": "5.22.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.41.0"
  }
}
